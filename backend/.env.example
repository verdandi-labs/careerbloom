# Neon / PostgreSQL
NEON_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Crypto
MASTER_KEY=generate-with-fernet-generate-key
HMAC_SECRET=generate-with-openssl-rand-base64-32

# Google AI
GEMINI_API_KEY=
GOOGLE_GEMINI_2_5_FLASH_MODEL=gemini-2.5-flash
GOOGLE_GEMINI_3_FLASH_MODEL=gemini-3-flash-preview

# SendGrid
SENDGRID_API_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App
SESSION_SECRET=generate-with-openssl-rand-base64-32
DEBUG=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
