# Neon / PostgreSQL
NEON_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Crypto
HMAC_SECRET=generate-with-openssl-rand-base64-32

# Google Cloud KMS (wraps per-user encryption keys)
GOOGLE_KMS_KEY_NAME=projects/YOUR_PROJECT/locations/europe-west1/keyRings/careerbloom/cryptoKeys/master-key
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Google AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# SendGrid
SENDGRID_API_KEY=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App
SESSION_SECRET=generate-with-openssl-rand-base64-32
DEBUG=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
