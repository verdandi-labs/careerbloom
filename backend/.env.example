# Neon / PostgreSQL
NEON_DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Crypto
HMAC_SECRET=generate-with-openssl-rand-base64-32
# Fernet master key that wraps per-user encryption keys (32-byte base64-urlsafe)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_KEY=

# Groq (primary LLM provider)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Mistral (LLM fallback)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# App
SESSION_SECRET=generate-with-openssl-rand-base64-32
DEBUG=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
